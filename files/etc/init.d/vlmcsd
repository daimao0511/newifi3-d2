#!/bin/sh /etc/rc.common
# /etc/init.d/vlmcsd —— KMS 激活服务（vLMCSD）
#
# 编译：GitHub Actions 里用 OpenWrt SDK 的 mipsel_24kc/musl 工具链从源码编，
#       带 -DFULL_INTERNAL_DATA，KMS 数据内嵌在二进制里，运行时不依赖
#       /etc/vlmcsd.kmd。产物约 61 KB，落在只读 squashfs 上，不写 NAND。
#
# 参数说明：
#   -D           前台运行（procd 要能盯着）
#   -e           日志打到 stdout，由 procd 收进 logread
#   -L addr:port 监听地址与端口，默认 0.0.0.0:1688，可在 LuCI「服务 → KMS 激活」里改
#
# 配置：/etc/config/vlmcsd
#   option enabled  1/0，关掉则进程不启动
#   option listen   监听地址，0.0.0.0 = 所有网卡
#   option port     端口，默认 1688
#
# 手工调试：/etc/init.d/vlmcsd restart && logread -e vlmcsd | tail

START=95
STOP=10
USE_PROCD=1

# 端口必须是 1-65535 的整数，脏值直接退回 1688，免得 procd 起一个没人能连的实例
valid_port() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

start_service() {
	local enabled listen port

	config_load vlmcsd
	config_get_bool enabled main enabled 1
	config_get listen main listen '0.0.0.0'
	config_get port main port '1688'

	if [ "$enabled" -ne 1 ]; then
		logger -t vlmcsd "disabled by /etc/config/vlmcsd, not starting"
		return 0
	fi

	valid_port "$port" || {
		logger -t vlmcsd "invalid port '$port', falling back to 1688"
		port=1688
	}
	[ -n "$listen" ] || listen='0.0.0.0'

	procd_open_instance
	procd_set_param command /usr/bin/vlmcsd -D -e -L "$listen:$port"
	# 起不来就 5 秒后重试，正常跑着就不会无故重启
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	# LuCI 里点「保存并应用」会触发 reload_config，靠这个 trigger 用新端口重启
	procd_add_reload_trigger "vlmcsd"
}
