#!/bin/sh
#
# 首次启动执行一次，成功后 OpenWrt 自动把它从 /etc/uci-defaults 删掉，
# 不会每次开机重复跑。
#
# 内容 = 这台机器真实在用的配置，别的一律不碰：
#   1) LAN 172.20.0.1/24
#   2) wan2 = lan1, 192.168.116.253/24
#   3) 4 条静态路由经 192.168.116.250
#   4) 防火墙 wan 区纳入 wan2，放行 1089 / 1688
#   5) 代理服务、KMS 服务自启
#   6) wifi 关掉、apk 源换国内镜像
#
# 注意：25.12 / 24.10 的 ramips/mt7621 都是 DSA，网口直接叫 lan1~lan4 / wan，
# 不需要 VLAN 那套 swconfig 操作。设备树里 port@3 = lan1，就是原来 swconfig
# 固件上的 switch port 3。

[ -f /etc/config/network ] || exit 1

# ---------------- LAN ----------------
uci set network.lan.ipaddr='172.20.0.1'
uci set network.lan.netmask='255.255.255.0'

# ---------------- 把 lan1 从 br-lan 摘出来 ----------------
# br-lan 是匿名的 config device 段，只能按 name 找到它的下标
i=0
while [ "$i" -lt 20 ]; do
	uci -q get "network.@device[$i]" >/dev/null 2>&1 || break
	if [ "$(uci -q get "network.@device[$i].name")" = "br-lan" ]; then
		uci -q del_list "network.@device[$i].ports=lan1"
		break
	fi
	i=$((i + 1))
done

# ---------------- wan2 ----------------
uci -q delete network.wan2
uci set network.wan2=interface
uci set network.wan2.device='lan1'
uci set network.wan2.proto='static'
uci set network.wan2.ipaddr='192.168.116.253'
uci set network.wan2.netmask='255.255.255.0'
uci set network.wan2.auto='1'

# ---------------- 4 条静态路由 ----------------
for t in 192.168.0.0/16 59.227.152.125/32 10.85.200.100/32 10.85.200.99/32; do
	uci add network route >/dev/null
	uci set "network.@route[-1].interface=wan2"
	uci set "network.@route[-1].target=$t"
	uci set "network.@route[-1].gateway=192.168.116.250"
done

uci commit network

# ---------------- 防火墙 ----------------
# wan 区纳入 wan2（按 name 找下标，不依赖固定顺序）
j=0
while [ "$j" -lt 20 ]; do
	uci -q get "firewall.@zone[$j]" >/dev/null 2>&1 || break
	if [ "$(uci -q get "firewall.@zone[$j].name")" = "wan" ]; then
		uci add_list "firewall.@zone[$j].network=wan2"
		break
	fi
	j=$((j + 1))
done

# 放行 1089 / 1688，源地址按 wan2 侧整段 /16 放，避免以后又漏网段。
# lan 区默认 input ACCEPT，所以内网访问这两个端口不用额外加规则。
for p in 1089:Allow-proxy-mipsle-1089 1688:Allow-kms-1688; do
	uci add firewall rule >/dev/null
	uci set "firewall.@rule[-1].name=${p#*:}"
	uci set "firewall.@rule[-1].src=wan"
	uci set "firewall.@rule[-1].src_ip=192.168.0.0/16"
	uci set "firewall.@rule[-1].proto=tcp"
	uci set "firewall.@rule[-1].dest_port=${p%%:*}"
	uci set "firewall.@rule[-1].target=ACCEPT"
done

uci commit firewall

# ---------------- DNS：给 KMS 一个短名字 ----------------
# 客户端 slmgr /skms kms.lan:1688 就能用，不用记 IP
uci -q add_list 'dhcp.@dnsmasq[0].address=/kms.lan/172.20.0.1'
uci commit dhcp

# ---------------- 代理服务自启 ----------------
# 二进制仍然只在 /tmp（内存盘），闪存上只有这个 2KB 的 init 脚本，不写 NAND
if [ -x /etc/init.d/proxy-mipsle ]; then
	/etc/init.d/proxy-mipsle enable
	# 此刻网络还没起来，拉不下来没关系：procd 是 respawn 0 5 0（无限重试），
	# 等 WAN 通了以后自己会成功
	/etc/init.d/proxy-mipsle start &
fi

# ---------------- KMS 激活服务自启 ----------------
# 纯本地服务，不依赖网络，直接起
if [ -x /etc/init.d/vlmcsd ]; then
	/etc/init.d/vlmcsd enable
	/etc/init.d/vlmcsd start
fi

# ---------------- 关 wifi（这台只当有线路由用） ----------------
# 首启时 /etc/config/wireless 由 mac80211 自动生成，未必已经存在；
# 只有确实生成了 wifi-device 段才去改，避免写出半截配置把 wifi 弄坏。
# 本固件已经把 wifi 驱动整个剔了，这段只是为了将来万一加回来时能自动关掉。
if uci -q get 'wireless.@wifi-device[0]' >/dev/null 2>&1; then
	uci set 'wireless.@wifi-device[0].disabled=1'
	uci -q set 'wireless.@wifi-device[1].disabled=1'
	uci commit wireless
fi

# ---------------- 界面：中文 + footstrap 主题 ----------------
# 语言包（luci-i18n-*-zh-cn）已编进固件，这里把默认语言固定下来，
# 不依赖浏览器的 Accept-Language。
uci set luci.main.lang='zh_cn'
# footstrap：左侧可折叠栏 + 亮暗两套配色 + 菜单搜索，比默认 bootstrap 好用。
# 想换回来就改成 /luci-static/bootstrap（bootstrap / bootstrap-dark / bootstrap-light 都在）。
uci set luci.main.mediaurlbase='/luci-static/footstrap'
uci commit luci

# ---------------- 软件源换国内镜像 ----------------
# 只换域名，路径和 kmods 的 kernel 版本号保持原样。官方源在国内拉包太慢。
# 25.12 是 apk，源清单在 /etc/apk/repositories.d/*.list，不是 /etc/apk/repositories
for f in /etc/apk/repositories /etc/apk/repositories.d/*.list; do
	[ -f "$f" ] && sed -i 's#https://downloads.openwrt.org#https://mirrors.ustc.edu.cn/openwrt#' "$f"
done
# 24.10 及更早用的是 opkg
if [ -f /etc/opkg/distfeeds.conf ]; then
	sed -i 's#https://downloads.openwrt.org#https://mirrors.ustc.edu.cn/openwrt#' /etc/opkg/distfeeds.conf
fi

exit 0
