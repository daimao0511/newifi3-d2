#!/bin/sh
#
# 首次启动执行一次，成功后 OpenWrt 自动把它从 /etc/uci-defaults 删掉，
# 不会每次开机重复跑。
#
# 内容 = 这台机器真实在用的配置，别的一律不碰：
#   1) LAN 172.20.0.1/24
#   2) wan2 = lan1, 192.168.116.253/24
#   3) 4 条静态路由经 192.168.116.250
#   4) 防火墙 wan 区纳入 wan2，放行 1089 / 1688 / 123
#   5) 代理服务、KMS 服务自启
#   6) SQM 整形（cake）、NTP 服务端
#   7) wifi 关掉、apk 源换国内镜像
#
# 注意：25.12 / 24.10 的 ramips/mt7621 都是 DSA，网口直接叫 lan1~lan4 / wan，
# 不需要 VLAN 那套 swconfig 操作。设备树里 port@3 = lan1，就是原来 swconfig
# 固件上的 switch port 3。

[ -f /etc/config/network ] || exit 1

# ---------------- LAN ----------------
uci set network.lan.ipaddr='172.20.0.1'
uci set network.lan.netmask='255.255.255.0'

# ---------------- 把 lan1 从 br-lan 摘出来 ----------------
# br-lan 是匿名的 config device 段，只能按 name 找到它的下标
i=0
while [ "$i" -lt 20 ]; do
	uci -q get "network.@device[$i]" >/dev/null 2>&1 || break
	if [ "$(uci -q get "network.@device[$i].name")" = "br-lan" ]; then
		uci -q del_list "network.@device[$i].ports=lan1"
		break
	fi
	i=$((i + 1))
done

# ---------------- wan2 ----------------
uci -q delete network.wan2
uci set network.wan2=interface
uci set network.wan2.device='lan1'
uci set network.wan2.proto='static'
uci set network.wan2.ipaddr='192.168.116.253'
uci set network.wan2.netmask='255.255.255.0'
uci set network.wan2.auto='1'

# ---------------- 4 条静态路由 ----------------
for t in 192.168.0.0/16 59.227.152.125/32 10.85.200.100/32 10.85.200.99/32; do
	uci add network route >/dev/null
	uci set "network.@route[-1].interface=wan2"
	uci set "network.@route[-1].target=$t"
	uci set "network.@route[-1].gateway=192.168.116.250"
done

uci commit network

# ---------------- 防火墙 ----------------
# wan 区纳入 wan2（按 name 找下标，不依赖固定顺序）
j=0
while [ "$j" -lt 20 ]; do
	uci -q get "firewall.@zone[$j]" >/dev/null 2>&1 || break
	if [ "$(uci -q get "firewall.@zone[$j].name")" = "wan" ]; then
		uci add_list "firewall.@zone[$j].network=wan2"
		break
	fi
	j=$((j + 1))
done

# 放行端口，源地址按 wan2 侧整段 /16 放，避免以后又漏网段。
# lan 区默认 input ACCEPT，所以内网访问这些端口不用额外加规则。
add_rule() { # $1 端口  $2 协议  $3 规则名
	uci add firewall rule >/dev/null
	uci set "firewall.@rule[-1].name=$3"
	uci set "firewall.@rule[-1].src=wan"
	uci set "firewall.@rule[-1].src_ip=192.168.0.0/16"
	uci set "firewall.@rule[-1].proto=$2"
	uci set "firewall.@rule[-1].dest_port=$1"
	uci set "firewall.@rule[-1].target=ACCEPT"
}
add_rule 1089 tcp Allow-proxy-mipsle-1089
add_rule 1688 tcp Allow-kms-1688
add_rule 123 udp Allow-ntp-123

# SQM 和 flow offloading 是互斥的：offload 让转发流量跳过 qdisc，
# 一旦打开 SQM 就完全不生效（看着配好了其实没排队）。这里显式关掉。
uci set firewall.@defaults[0].flow_offloading='0'
uci set firewall.@defaults[0].flow_offloading_hw='0'

uci commit firewall

# ---------------- DNS：给 KMS 一个短名字 ----------------
# 客户端 slmgr /skms kms.lan:1688 就能用，不用记 IP
uci -q add_list 'dhcp.@dnsmasq[0].address=/kms.lan/172.20.0.1'
uci commit dhcp

# ---------------- 代理服务自启 ----------------
# 二进制仍然只在 /tmp（内存盘），闪存上只有这个 2KB 的 init 脚本，不写 NAND
if [ -x /etc/init.d/proxy-mipsle ]; then
	/etc/init.d/proxy-mipsle enable
	# 此刻网络还没起来，拉不下来没关系：procd 是 respawn 0 5 0（无限重试），
	# 等 WAN 通了以后自己会成功
	/etc/init.d/proxy-mipsle start &
fi

# ---------------- KMS 激活服务自启 ----------------
# 纯本地服务，不依赖网络，直接起
if [ -x /etc/init.d/vlmcsd ]; then
	/etc/init.d/vlmcsd enable
	/etc/init.d/vlmcsd start
fi

# ---------------- SQM 智能整形（cake） ----------------
# 这条线实测下行 75 Mbps / 上行 61 Mbps（WAN 百兆协商，跑不满千兆），
# 之前按 12 Mbps 填 10500/3000 是照老线路估的，把 75M 的线硬压成 10.5M。
# cake 不提速，它治的是 bufferbloat：满速下载时延迟从几百毫秒压到十几毫秒，
# 网页还能开、语音不掉。代价是峰值带宽被压到设定值的 85% 左右。
#
# download / upload 单位是 kbit/s，各自填「实测值 × 0.9」：
#   实测 75000 → 填 70000；实测 61000 → 填 56000（留一点余量给 ATM 开销和抖动）
#   填大了 → 整形器不触发，等于没开；填小了 → 白丢带宽。
# 改这里不如改界面：LuCI → 网络 → SQM QoS，改完点「应用」立即生效，不用重编固件。
uci -q delete sqm.@queue[0]
uci add sqm queue >/dev/null
uci set sqm.@queue[-1].enabled='1'
uci set sqm.@queue[-1].interface='wan'
uci set sqm.@queue[-1].download='70000'
uci set sqm.@queue[-1].upload='56000'
# piece_of_cake：进出两个方向都挂 cake，不做 DSCP 分类，最简单也最稳
uci set sqm.@queue[-1].script='piece_of_cake.qos'
uci set sqm.@queue[-1].qdisc='cake'
uci set sqm.@queue[-1].linklayer='ethernet'
uci set sqm.@queue[-1].linklayer_adaptation_mechanism='default'
uci set sqm.@queue[-1].overhead='0'
uci set sqm.@queue[-1].ingress_ecn='ECN'
uci set sqm.@queue[-1].egress_ecn='ECN'
uci set sqm.@queue[-1].squash_dscp='1'
uci set sqm.@queue[-1].squash_ingress='1'
uci set sqm.@queue[-1].verbosity='5'
uci set sqm.@queue[-1].debug_logging='0'
uci commit sqm
/etc/init.d/sqm enable
# 此刻 wan 可能还没拿到地址，起不来也没关系：enabled 之后本次 rcS 会再拉一次
/etc/init.d/sqm restart >/dev/null 2>&1

# ---------------- NTP 服务端 ----------------
# enable_server=1 让 busybox ntpd 带 -l 参数对外应答；不加这个它只做客户端。
# 上游服务器换成国内节点：默认那 4 个 pool.ntp.org 在国内解析慢、同步经常超时。
# KMS 激活对时间敏感（客户端与服务器偏差超过 4 小时直接失败），
# 内网机器统一指到路由器校时，比各自去连公网 NTP 稳。
uci set system.ntp.enabled='1'
uci set system.ntp.enable_server='1'
uci -q delete system.ntp.server
uci add_list system.ntp.server='ntp.aliyun.com'
uci add_list system.ntp.server='ntp.tencent.com'
uci add_list system.ntp.server='ntp.ntsc.ac.cn'
uci commit system
/etc/init.d/sysntpd enable
/etc/init.d/sysntpd restart >/dev/null 2>&1

# ---------------- 关 wifi（这台只当有线路由用） ----------------
# 首启时 /etc/config/wireless 由 mac80211 自动生成，未必已经存在；
# 只有确实生成了 wifi-device 段才去改，避免写出半截配置把 wifi 弄坏。
# 本固件已经把 wifi 驱动整个剔了，这段只是为了将来万一加回来时能自动关掉。
if uci -q get 'wireless.@wifi-device[0]' >/dev/null 2>&1; then
	uci set 'wireless.@wifi-device[0].disabled=1'
	uci -q set 'wireless.@wifi-device[1].disabled=1'
	uci commit wireless
fi

# ---------------- 界面：中文 + argon 主题 ----------------
# 语言包（luci-i18n-*-zh-cn）已编进固件，这里把默认语言固定下来，
# 不依赖浏览器的 Accept-Language。
uci set luci.main.lang='zh_cn'
# argon：左侧菜单栏那套。整套文件（www 静态资源 + ucode 模板 + rpcd 脚本）
# 都塞在固件 files/ 里，直接进 squashfs，不占 overlay。
# 想换回官方样式就改成 /luci-static/bootstrap。
uci set luci.main.mediaurlbase='/luci-static/argon'
uci set luci.themes.Argon='/luci-static/argon'
uci commit luci
# argon 的 rpcd 后端要重新注册才认得，否则主题设置页读不到参数
/etc/init.d/rpcd restart >/dev/null 2>&1

# ---------------- 软件源换国内镜像 ----------------
# 只换域名，路径和 kmods 的 kernel 版本号保持原样。官方源在国内拉包太慢。
# 25.12 是 apk，源清单在 /etc/apk/repositories.d/*.list，不是 /etc/apk/repositories
for f in /etc/apk/repositories /etc/apk/repositories.d/*.list; do
	[ -f "$f" ] && sed -i 's#https://downloads.openwrt.org#https://mirrors.ustc.edu.cn/openwrt#' "$f"
done
# 24.10 及更早用的是 opkg
if [ -f /etc/opkg/distfeeds.conf ]; then
	sed -i 's#https://downloads.openwrt.org#https://mirrors.ustc.edu.cn/openwrt#' /etc/opkg/distfeeds.conf
fi

# ---------------- root 密码兜底 / SSH 登录 ----------------
# 刷完机 root 默认空密码，dropbear 直接拒绝登录；万一 LuCI 又因为主题/模板
# 报错打不开，就彻底没有入口了（只能上 breed 重刷或拆机）。
# 这里只在密码确实为空时设一个，已有密码一律不动，所以后续刷机默认保留原密码。
ROOT_PASS='password'
if ! grep -q '^root:[^!*]' /etc/shadow 2>/dev/null; then
	printf '%s\n%s\n' "$ROOT_PASS" "$ROOT_PASS" | passwd root >/dev/null 2>&1 \
		&& echo "root password set to default ($ROOT_PASS)"
fi
uci -q set dropbear.@dropbear[0].PasswordAuth='on'
uci -q set dropbear.@dropbear[0].RootPasswordAuth='on'
uci -q commit dropbear

exit 0
